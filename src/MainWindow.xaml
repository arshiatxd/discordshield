<Window x:Class="DiscordTunnel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord Shield" Height="588" Width="348"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Icon="app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="Segoe UI Variable Text, Segoe UI, Arial"
        FontSize="12.5"
        MouseDown="Window_MouseDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <QuinticEase x:Key="EaseOutStrong" EasingMode="EaseOut"/>

        <LinearGradientBrush x:Key="ShackleMetal" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E8F0" Offset="0.22"/>
            <GradientStop Color="#94A3B8" Offset="0.48"/>
            <GradientStop Color="#F1F5F9" Offset="0.72"/>
            <GradientStop Color="#64748B" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleLockBodyGradient" StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Color="#818CF8" Offset="0.0"/>
            <GradientStop Color="#5865F2" Offset="0.45"/>
            <GradientStop Color="#3B429F" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreyLockBodyGradient" StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Color="#4E5058" Offset="0.0"/>
            <GradientStop Color="#313338" Offset="0.45"/>
            <GradientStop Color="#232428" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BevelHighlight" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#05FFFFFF" Offset="0.0"/>
            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
            <GradientStop Color="#05FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="24"
                                BorderBrush="#30FFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Border x:Name="HoverLayer" Background="#14FFFFFF" CornerRadius="24" Opacity="0"/>
                                <Border Height="1.5" VerticalAlignment="Top" Margin="24,1,24,0" Background="{StaticResource BevelHighlight}" CornerRadius="1"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutStrong}"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutStrong}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Cancel connection"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse Fill="#1FEF4444" Stroke="#66EF4444" StrokeThickness="1"/>
                            <Ellipse x:Name="Fill" Fill="#DA373C" Opacity="0"/>
                            <Path x:Name="Glyph" Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Stroke" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutStrong}"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutStrong}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#949BA4"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Tag" Value="#35373C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="Transparent">
                            <Grid>
                                <Border x:Name="Hover" CornerRadius="10" Background="{TemplateBinding Tag}" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackBrush" Color="#4E5058"/>
                                </Border.Background>
                                <Canvas Width="40" Height="22">
                                    <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" Background="White" Canvas.Left="3" Canvas.Top="3">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>
                                </Canvas>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#23A55A" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Canvas.Left)" To="21" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutStrong}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color" To="#4E5058" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Canvas.Left)" To="3" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutStrong}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RegionOptionTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="24" Height="16" CornerRadius="3" Margin="0,0,12,0" ClipToBounds="True" BorderBrush="#25FFFFFF" BorderThickness="0.5">
                    <Grid>
                        <Grid x:Name="FlagAuto" Visibility="Collapsed" Background="#4F46E5">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Width="9" Height="12" Stretch="Uniform" Fill="#FEE75C"
                                  Data="M 7 0 L 0 8 L 5 8 L 3 14 L 10 6 L 5 6 Z"/>
                        </Grid>

                        <Grid x:Name="FlagIR" Visibility="Collapsed">
                            <Image Source="flag_ir.png" Width="24" Height="16" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <Canvas x:Name="FlagTR" Visibility="Collapsed" Width="24" Height="16" Background="#E30A17">
                            <Ellipse Canvas.Left="5" Canvas.Top="2.5" Width="11" Height="11" Fill="#FFFFFF"/>
                            <Ellipse Canvas.Left="7.5" Canvas.Top="3.5" Width="9" Height="9" Fill="#E30A17"/>
                            <Path Canvas.Left="13.5" Canvas.Top="5" Fill="#FFFFFF"
                                  Data="M 3 0 L 3.8 2.5 L 6.5 2.5 L 4.3 4.1 L 5.2 6.5 L 3 5.0 L 0.8 6.5 L 1.7 4.1 L -0.5 2.5 L 2.2 2.5 Z"/>
                        </Canvas>

                        <Grid x:Name="FlagRU" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FFFFFF"/>
                            <Border Grid.Row="1" Background="#0039A6"/>
                            <Border Grid.Row="2" Background="#D52B1E"/>
                        </Grid>

                        <Grid x:Name="FlagAE" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6.5"/>
                                <ColumnDefinition Width="17.5"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#FF0000"/>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#00732F"/>
                                <Border Grid.Row="1" Background="#FFFFFF"/>
                                <Border Grid.Row="2" Background="#000000"/>
                            </Grid>
                        </Grid>

                        <Grid x:Name="FlagGL" Visibility="Collapsed" Background="#35373C">
                            <Ellipse Width="11" Height="11" Stroke="#DBDEE1" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="5" Height="11" Stroke="#DBDEE1" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path Data="M 0 0 L 11 0" Stroke="#DBDEE1" StrokeThickness="1" Width="11" Height="1" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Code}" Value="AUTO">
                    <Setter TargetName="FlagAuto" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="IR">
                    <Setter TargetName="FlagIR" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="TR">
                    <Setter TargetName="FlagTR" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="RU">
                    <Setter TargetName="FlagRU" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="AE">
                    <Setter TargetName="FlagAE" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="GL">
                    <Setter TargetName="FlagGL" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SelectorButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#DBDEE1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="19" BorderThickness="1" Background="#1E1F22">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="EdgeBrush" Color="#3F4147"/>
                            </Border.BorderBrush>
                            <Grid>
                                <ContentPresenter Margin="14,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path x:Name="Chevron" Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="#949BA4" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Open">
                                <Setter TargetName="Chevron" Property="Stroke" Value="#8EA1FF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOutStrong}"/>
                                            <ColorAnimation Storyboard.TargetName="EdgeBrush" Storyboard.TargetProperty="Color" To="#5865F2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOutStrong}"/>
                                            <ColorAnimation Storyboard.TargetName="EdgeBrush" Storyboard.TargetProperty="Color" To="#3F4147" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="{x:Null}"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="EdgeBrush" Storyboard.TargetProperty="Color" To="#5865F2" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="EdgeBrush" Storyboard.TargetProperty="Color" To="#3F4147" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListItemButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#DBDEE1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="38" Margin="0,1">
                            <Border x:Name="Hover" CornerRadius="12" Background="#313338" Opacity="0"/>
                            <Border x:Name="Selected" CornerRadius="12" Background="#265865F2" Opacity="0"/>
                            <ContentPresenter Margin="12,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Path x:Name="Check" Data="M 0 4 L 3.5 7.5 L 10 0" Stroke="#8EA1FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Selected" Property="Opacity" Value="1"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RegionListItemTemplate">
            <Button x:Name="Item" Style="{StaticResource ListItemButtonStyle}" ContentTemplate="{StaticResource RegionOptionTemplate}"
                    Content="{Binding}" Click="RegionItem_Click"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Item" Property="Tag" Value="Selected"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="WindowFrame" CornerRadius="42" BorderBrush="#35373C" BorderThickness="1.5">
            <Grid x:Name="RootContainer">
                <Border x:Name="GreyBackground" CornerRadius="40.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2B2D31" Offset="0.0"/>
                            <GradientStop Color="#1E1F22" Offset="0.45"/>
                            <GradientStop Color="#141518" Offset="0.80"/>
                            <GradientStop Color="#0E0F12" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border x:Name="PurpleBackground" CornerRadius="40.5" Opacity="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B429F" Offset="0.0"/>
                            <GradientStop Color="#4F46E5" Offset="0.35"/>
                            <GradientStop Color="#5865F2" Offset="0.70"/>
                            <GradientStop Color="#312E81" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="40.5" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.22" GradientOrigin="0.5,0.22" RadiusX="0.65" RadiusY="0.45">
                            <GradientStop Color="#1E5865F2" Offset="0.0"/>
                            <GradientStop Color="#005865F2" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Grid x:Name="MainLayout">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="62"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent" Margin="6,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <Image Source="app_logo.png" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Discord Shield" Foreground="#F2F3F5" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border x:Name="PingBadge" Visibility="Collapsed" Opacity="0" Background="#2623A55A" BorderBrush="#4D23A55A" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#23A55A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PingBadgeText" Text="-- ms" Foreground="#4ADE80" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="MenuBtn" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="Menu" Click="MenuBtn_Click" Margin="0,0,2,0" ToolTip="Menu">
                                <StackPanel Orientation="Vertical">
                                    <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,2.5"/>
                                    <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="MinimizeBtn" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="Minimize" Click="MinimizeBtn_Click" Margin="0,0,2,0" ToolTip="Minimize">
                                <Path Data="M 0 0 L 10 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None"/>
                            </Button>
                            <Button x:Name="CloseBtn" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="Close" Tag="#DA373C" Click="CloseBtn_Click" ToolTip="Close">
                                <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="240" Height="190" HorizontalAlignment="Center" Margin="0,-6,0,-4">
                            <Ellipse x:Name="LockGlow" Width="240" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="LockGlowScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#77818CF8" Offset="0.0"/>
                                        <GradientStop Color="#386366F1" Offset="0.45"/>
                                        <GradientStop Color="#006366F1" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Viewbox x:Name="LockAssemblyViewbox" Width="175" Height="175" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.55">
                                <Viewbox.RenderTransform>
                                    <ScaleTransform x:Name="LockBodyScale" ScaleX="1" ScaleY="1"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="512" Height="512">
                                    <Canvas x:Name="ShackleGroup">
                                        <Canvas.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform x:Name="ShackleTranslate" X="0" Y="0"/>
                                                <RotateTransform x:Name="ShackleRotate" Angle="0" CenterX="352" CenterY="245"/>
                                            </TransformGroup>
                                        </Canvas.RenderTransform>

                                        <Path Data="M 160 245 L 160 135 C 160 55, 352 55, 352 135 L 352 245"
                                              Fill="{x:Null}"
                                              Stroke="{StaticResource ShackleMetal}"
                                              StrokeThickness="38"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round">
                                            <Path.Effect>
                                                <DropShadowEffect BlurRadius="14" ShadowDepth="6" Color="#000000" Opacity="0.40"/>
                                            </Path.Effect>
                                        </Path>

                                        <Path Data="M 168 245 L 168 135 C 168 67, 344 67, 344 135 L 344 245"
                                              Fill="{x:Null}"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="8"
                                              StrokeStartLineCap="Round"
                                              Opacity="0.72"/>

                                        <Rectangle Canvas.Left="145" Canvas.Top="228" Width="22" Height="6" RadiusX="2" RadiusY="2" Fill="#475569"/>
                                    </Canvas>

                                    <Ellipse Canvas.Left="140" Canvas.Top="227" Width="40" Height="16" Fill="#141518" Opacity="0.92"/>
                                    <Ellipse Canvas.Left="332" Canvas.Top="227" Width="40" Height="16" Fill="#141518" Opacity="0.92"/>

                                    <Border x:Name="LockBodyBorder" Canvas.Left="106" Canvas.Top="215" Width="300" Height="240"
                                            CornerRadius="46" Background="{StaticResource GreyLockBodyGradient}"
                                            BorderBrush="#4E5058" BorderThickness="1.8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="26" ShadowDepth="9" Color="#000000" Opacity="0.48"/>
                                        </Border.Effect>

                                        <Grid>
                                            <Border Height="3" VerticalAlignment="Top" Margin="28,2,28,0" Background="{StaticResource BevelHighlight}" CornerRadius="1.5"/>

                                            <Viewbox Width="150" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10" RenderTransformOrigin="0.5,0.5">
                                                <Viewbox.RenderTransform>
                                                    <ScaleTransform x:Name="LogoEmblemScale" ScaleX="1" ScaleY="1"/>
                                                </Viewbox.RenderTransform>
                                                <Path Fill="#FFFFFF"
                                                      Data="M19.3 4.3C17.8 3.6 16.3 3.1 14.7 2.8C14.5 3.2 14.3 3.7 14.1 4.1C12.4 3.8 10.7 3.8 9 4.1C8.8 3.7 8.6 3.2 8.4 2.8C6.8 3.1 5.3 3.6 3.8 4.3C0.9 8.7 0.1 13 0.5 17.2C2.4 18.6 4.3 19.5 6.1 20C6.6 19.4 7 18.7 7.3 18C6.6 17.7 6 17.4 5.4 17C5.6 16.9 5.7 16.7 5.9 16.6C9.5 18.2 13.6 18.2 17.1 16.6C17.3 16.8 17.4 16.9 17.6 17C17 17.4 16.4 17.7 15.7 18C16.1 18.7 16.5 19.4 16.9 20C18.8 19.5 20.7 18.6 22.6 17.2C23.1 12.3 21.8 8 19.3 4.3ZM7.9 14.6C6.8 14.6 5.9 13.6 5.9 12.4C5.9 11.2 6.8 10.2 7.9 10.2C9 10.2 9.9 11.2 9.9 12.4C9.9 13.6 9 14.6 7.9 14.6ZM15.2 14.6C14.1 14.6 13.2 13.6 13.2 12.4C13.2 11.2 14.1 10.2 15.2 10.2C16.3 10.2 17.2 11.2 17.2 12.4C17.2 13.6 16.3 14.6 15.2 14.6Z">
                                                    <Path.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="#000000" Opacity="0.35"/>
                                                    </Path.Effect>
                                                </Path>
                                            </Viewbox>

                                            <Canvas HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Width="12" Height="16">
                                                <Ellipse x:Name="KeyholeTop" Width="8" Height="8" Canvas.Left="2" Fill="#232428" Opacity="0.85"/>
                                                <Path x:Name="KeyholeBottom" Data="M 3 5 L 9 5 L 7 14 L 5 14 Z" Fill="#232428" Opacity="0.85"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <TextBlock x:Name="StatusLabel" Text="DISCONNECTED" Foreground="#F2F3F5" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock x:Name="StatusSubLabel" Text="Discord traffic is direct" Foreground="#949BA4" FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="296" Margin="0,4,0,0"/>

                        <Button x:Name="RegionSelector" Style="{StaticResource SelectorButtonStyle}" AutomationProperties.Name="Region" ContentTemplate="{StaticResource RegionOptionTemplate}"
                                Width="264" Height="40" Margin="0,14,0,0" Click="RegionSelector_Click"/>

                        <Border x:Name="SecurityPill" Opacity="0" Background="#33000000" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="13" Padding="12,0" Height="26" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="10" Height="11" Stretch="Uniform" Fill="#8EA1FF" Margin="0,0,7,0" VerticalAlignment="Center"
                                      Data="M 6 0 L 0 2.5 L 0 6.5 C 0 10 3 12.5 6 13.5 C 9 12.5 12 10 12 6.5 L 12 2.5 Z"/>
                                <TextBlock x:Name="SecurityPillText" Text="Protected Tunnel" Foreground="#E3E5E8" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Width="236" Height="48" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ConnectBtn" Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Click="ConnectBtn_Click" Content="Connect">
                            <Button.Effect>
                                <DropShadowEffect x:Name="BtnShadow" BlurRadius="22" ShadowDepth="4" Opacity="0.45" Color="#5865F2"/>
                            </Button.Effect>
                        </Button>
                        <Border x:Name="CancelHost" Grid.Column="1" Width="0" ClipToBounds="True" Visibility="Collapsed">
                            <Button x:Name="CancelBtn" Style="{StaticResource CancelButtonStyle}" AutomationProperties.Name="Cancel" Click="CancelBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="HintLabel" Grid.Row="3" Text="Starting Discord may take a few tries to connect. If connection fails, try closing and reopening Discord completely."
                               Foreground="#8E9297" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" LineHeight="15"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,0,28,0"/>

                    <Border Grid.Row="4" Margin="24,0,24,16" Height="46" VerticalAlignment="Center" Background="#18191C" CornerRadius="23" Padding="16,0" BorderBrush="#2B2D31" BorderThickness="1">
                        <Grid>
                            <CheckBox x:Name="MinimizeToTrayCheckBox" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" VerticalAlignment="Center">
                                <TextBlock Text="Minimize to system tray" Foreground="#DBDEE1" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </CheckBox>
                            <TextBlock Text="v1.0.1" Foreground="#80848E" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="OverlayLayer" Visibility="Collapsed" Background="#01000000" MouseDown="OverlayLayer_MouseDown">
                    <Border x:Name="RegionDropdown" Visibility="Collapsed" Width="264" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#1E1F22" BorderBrush="#35373C" BorderThickness="1" CornerRadius="22" Padding="6" Opacity="0" RenderTransformOrigin="0.5,0">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="RegionDropdownScale" ScaleX="0.96" ScaleY="0.9"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <ItemsControl x:Name="RegionList" ItemTemplate="{StaticResource RegionListItemTemplate}"/>
                    </Border>

                    <Border x:Name="AppMenu" Visibility="Collapsed" Width="180" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#1E1F22" BorderBrush="#35373C" BorderThickness="1" CornerRadius="18" Padding="6" Opacity="0" RenderTransformOrigin="1,0">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AppMenuScale" ScaleX="0.94" ScaleY="0.9"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <Button x:Name="PrivacyMenuItem" Style="{StaticResource ListItemButtonStyle}" Click="PrivacyMenuItem_Click">
                            <TextBlock Text="Privacy Policy" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </Border>
                </Grid>

                <Grid x:Name="PrivacyModal" Visibility="Collapsed" Opacity="0" Background="#D00A0B0E" MouseDown="PrivacyModal_BackgroundMouseDown">
                    <Border x:Name="PrivacyCard" Width="312" Background="#1E1F22" CornerRadius="24" BorderBrush="#35373C" BorderThickness="1" Padding="22,20,22,20"
                            VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PrivacyScale" ScaleX="0.96" ScaleY="0.96"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Privacy Policy" Foreground="#F2F3F5" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Discord Shield runs entirely on your local computer." Foreground="#DBDEE1" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Foreground="#949BA4" FontSize="11.8" TextWrapping="Wrap" LineHeight="16.5" Margin="0,0,0,8">
                                <Run Foreground="#DBDEE1" FontWeight="SemiBold">Zero data collection.</Run>
                                <Run> Your account credentials, messages, voice audio, and browsing activity are never collected, logged, or sent to any third party.</Run>
                            </TextBlock>
                            <TextBlock Foreground="#949BA4" FontSize="11.8" TextWrapping="Wrap" LineHeight="16.5" Margin="0,0,0,8">
                                <Run Foreground="#DBDEE1" FontWeight="SemiBold">Safe local filtering.</Run>
                                <Run> Only Discord domains and desktop processes are handled using local packet desynchronization and a local SOCKS5 proxy, with no external VPN server.</Run>
                            </TextBlock>
                            <TextBlock Foreground="#949BA4" FontSize="11.8" TextWrapping="Wrap" LineHeight="16.5" Margin="0,0,0,8">
                                <Run Foreground="#DBDEE1" FontWeight="SemiBold">Antivirus transparency.</Run>
                                <Run> Packet-filtering utilities without an expensive Authenticode certificate can occasionally trigger heuristic warnings. Full source code is open for review on </Run>
                                <Hyperlink NavigateUri="https://github.com/arshiatxd/discordshield" RequestNavigate="ExternalLink_RequestNavigate" Foreground="#8EA1FF" TextDecorations="None">GitHub</Hyperlink><Run>.</Run>
                            </TextBlock>
                            <TextBlock Foreground="#949BA4" FontSize="11.8" TextWrapping="Wrap" LineHeight="16.5" Margin="0,0,0,16">
                                <Run Foreground="#DBDEE1" FontWeight="SemiBold">Runtime requirement.</Run>
                                <Run> Powered by the official </Run>
                                <Hyperlink NavigateUri="https://dotnet.microsoft.com/en-us/download/dotnet/10.0" RequestNavigate="ExternalLink_RequestNavigate" Foreground="#8EA1FF" TextDecorations="None">Microsoft .NET 10 Desktop Runtime</Hyperlink><Run>.</Run>
                            </TextBlock>
                            <Button x:Name="PrivacyCloseBtn" Style="{StaticResource PrimaryButtonStyle}" Click="PrivacyCloseBtn_Click" Content="Close" Height="40" FontSize="14" Background="#5865F2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
