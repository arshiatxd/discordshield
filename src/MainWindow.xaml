<Window x:Class="DiscordTunnel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord Shield" Height="588" Width="348"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Icon="app.ico"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, Arial"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <LinearGradientBrush x:Key="ShackleMetal" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E8F0" Offset="0.22"/>
            <GradientStop Color="#94A3B8" Offset="0.48"/>
            <GradientStop Color="#F1F5F9" Offset="0.72"/>
            <GradientStop Color="#64748B" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleLockBodyGradient" StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Color="#818CF8" Offset="0.0"/>
            <GradientStop Color="#5865F2" Offset="0.45"/>
            <GradientStop Color="#3B429F" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreyLockBodyGradient" StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Color="#4E5058" Offset="0.0"/>
            <GradientStop Color="#313338" Offset="0.45"/>
            <GradientStop Color="#232428" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BevelHighlight" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#05FFFFFF" Offset="0.0"/>
            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
            <GradientStop Color="#05FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonIdleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5865F2" Offset="0.0"/>
            <GradientStop Color="#4752C4" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonConnectedGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EF4444" Offset="0.0"/>
            <GradientStop Color="#DC2626" Offset="0.55"/>
            <GradientStop Color="#B91C1C" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="DiscordPillButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="24" BorderBrush="#30FFFFFF" BorderThickness="1">
                            <Grid>
                                <Border Height="1.5" VerticalAlignment="Top" Margin="24,1,24,0" Background="{StaticResource BevelHighlight}" CornerRadius="1"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.93"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.82"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCtrlBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#949BA4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#35373C"/>
                                <Setter Property="Foreground" Value="#F2F3F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCtrlBtn" TargetType="Button" BasedOn="{StaticResource WindowCtrlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#DA373C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiscordToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#4E5058">
                                <Canvas Width="40" Height="22">
                                    <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" Background="White" Canvas.Left="3" Canvas.Top="3">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>
                                </Canvas>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#23A55A"/>
                                <Setter TargetName="Thumb" Property="Canvas.Left" Value="21"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16">
                <Grid>
                    <Path x:Name="Arrow" Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="#949BA4" StrokeThickness="1.7"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#5865F2"/>
                    <Setter TargetName="border" Property="Background" Value="#2B2D31"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#5865F2"/>
                    <Setter TargetName="border" Property="Background" Value="#2B2D31"/>
                    <Setter TargetName="Arrow" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180"/>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#5865F2"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <DataTemplate x:Key="RegionOptionTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="24" Height="16" CornerRadius="3" Margin="0,0,10,0" ClipToBounds="True" BorderBrush="#25FFFFFF" BorderThickness="0.5">
                    <Grid>
                        <Canvas x:Name="FlagTR" Visibility="Collapsed" Width="24" Height="16" Background="#E30A17">
                            <Ellipse Canvas.Left="5" Canvas.Top="2.5" Width="11" Height="11" Fill="#FFFFFF"/>
                            <Ellipse Canvas.Left="7.5" Canvas.Top="3.5" Width="9" Height="9" Fill="#E30A17"/>
                            <Path Canvas.Left="13.5" Canvas.Top="5" Fill="#FFFFFF"
                                  Data="M 3 0 L 3.8 2.5 L 6.5 2.5 L 4.3 4.1 L 5.2 6.5 L 3 5.0 L 0.8 6.5 L 1.7 4.1 L -0.5 2.5 L 2.2 2.5 Z"/>
                        </Canvas>

                        <Grid x:Name="FlagRU" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FFFFFF"/>
                            <Border Grid.Row="1" Background="#0039A6"/>
                            <Border Grid.Row="2" Background="#D52B1E"/>
                        </Grid>

                        <Grid x:Name="FlagIR" Visibility="Collapsed">
                            <Image Source="pack://application:,,,/flag_ir.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Fill"/>
                        </Grid>

                        <Grid x:Name="FlagAE" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6.5"/>
                                <ColumnDefinition Width="17.5"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#FF0000"/>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#00732F"/>
                                <Border Grid.Row="1" Background="#FFFFFF"/>
                                <Border Grid.Row="2" Background="#000000"/>
                            </Grid>
                        </Grid>

                        <Grid x:Name="FlagGL" Visibility="Collapsed" Background="#2B2D31">
                            <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="20" Height="20">
                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="16" Height="16" Stroke="#949BA4" StrokeThickness="1.5" Fill="#1E1F22"/>
                                    <Ellipse Canvas.Left="6" Canvas.Top="2" Width="8" Height="16" Stroke="#949BA4" StrokeThickness="1.2" Fill="Transparent"/>
                                    <Line X1="2" Y1="10" X2="18" Y2="10" Stroke="#949BA4" StrokeThickness="1.2"/>
                                    <Line X1="3.5" Y1="6" X2="16.5" Y2="6" Stroke="#949BA4" StrokeThickness="1"/>
                                    <Line X1="3.5" Y1="14" X2="16.5" Y2="14" Stroke="#949BA4" StrokeThickness="1"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <Grid x:Name="FlagAuto" Visibility="Collapsed" Background="#4F46E5">
                            <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M 9.5,1.5 L 4.5,8.5 L 8.5,8.5 L 6.5,14.5 L 12.5,7.5 L 8.5,7.5 Z" Fill="#FEE75C"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Code}" Value="TR">
                    <Setter TargetName="FlagTR" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="RU">
                    <Setter TargetName="FlagRU" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="IR">
                    <Setter TargetName="FlagIR" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="AE">
                    <Setter TargetName="FlagAE" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="GL">
                    <Setter TargetName="FlagGL" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Code}" Value="AUTO">
                    <Setter TargetName="FlagAuto" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="DiscordComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#DBDEE1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1E1F22"/>
            <Setter Property="BorderBrush" Value="#3F4147"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6,32,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Fade" Focusable="False">
                                <Border x:Name="dropDownBorder" Background="#1E1F22" BorderBrush="#4E5058" BorderThickness="1"
                                        CornerRadius="14" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True" MaxHeight="220">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#DBDEE1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Margin="2,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#313338"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#5865F2"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="WindowFrame" Margin="0" CornerRadius="42" BorderBrush="#35373C" BorderThickness="1.5">
            <Grid x:Name="RootContainer">
                <Border x:Name="GreyBackground" CornerRadius="40.5" Opacity="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2B2D31" Offset="0.0"/>
                            <GradientStop Color="#1E1F22" Offset="0.45"/>
                            <GradientStop Color="#141518" Offset="0.80"/>
                            <GradientStop Color="#0E0F12" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border x:Name="PurpleBackground" CornerRadius="40.5" Opacity="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B429F" Offset="0.0"/>
                            <GradientStop Color="#4F46E5" Offset="0.35"/>
                            <GradientStop Color="#5865F2" Offset="0.70"/>
                            <GradientStop Color="#312E81" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="40.5" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.22" GradientOrigin="0.5,0.22" RadiusX="0.65" RadiusY="0.45">
                            <GradientStop Color="#1E5865F2" Offset="0.0"/>
                            <GradientStop Color="#005865F2" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="64"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent" Margin="6,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <Image Source="app_logo.png" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Discord Shield" Foreground="#F2F3F5" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border x:Name="PingBadge" Visibility="Collapsed" Background="#2623A55A" BorderBrush="#23A55A" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="PingDot" Width="6" Height="6" Fill="#23A55A" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PingBadgeText" Text="-- ms" Foreground="#4ADE80" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="MenuBtn" Style="{StaticResource WindowCtrlBtn}" Click="MenuBtn_Click" Content="..." FontSize="13" FontWeight="Bold" Margin="0,0,4,0">
                                <Button.ContextMenu>
                                    <ContextMenu Background="#1E1F22" BorderBrush="#35373C" BorderThickness="1">
                                        <MenuItem Header="Privacy Policy" Click="OpenPrivacyPolicy_Click" Foreground="#DBDEE1" FontSize="12"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Style="{StaticResource WindowCtrlBtn}" Click="MinimizeBtn_Click" Content="-" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource CloseCtrlBtn}" Click="CloseBtn_Click" Content="X"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="240" Height="190" HorizontalAlignment="Center" Margin="0,-6,0,-4">
                            <Ellipse x:Name="LockGlow" Width="240" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="LockGlowScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#4C5865F2" Offset="0.0"/>
                                        <GradientStop Color="#225865F2" Offset="0.45"/>
                                        <GradientStop Color="#005865F2" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Viewbox Width="124" Height="156" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="100" Height="124">
                                    <Path x:Name="ShacklePath"
                                          Data="M 32 62 L 32 30 C 32 14.5 40 4 50 4 C 60 4 68 14.5 68 30 L 68 62"
                                          Stroke="{StaticResource ShackleMetal}"
                                          StrokeThickness="12"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          RenderTransformOrigin="0.32, 0.48">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform x:Name="ShackleTranslate" X="0" Y="-14"/>
                                                <RotateTransform x:Name="ShackleRotate" Angle="-22"/>
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                        </Path.Effect>
                                    </Path>

                                    <Border Canvas.Left="12" Canvas.Top="48" Width="76" Height="68"
                                            CornerRadius="18"
                                            Background="{StaticResource GreyLockBodyGradient}"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="1"
                                            RenderTransformOrigin="0.5,0.5"
                                            x:Name="LockBodyBorder">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="LockBodyScale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="7" Opacity="0.55" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Border Height="1.5" VerticalAlignment="Top" Margin="14,1,14,0" Background="{StaticResource BevelHighlight}" CornerRadius="1"/>

                                            <Viewbox Width="36" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0">
                                                <Path x:Name="DiscordEmblem"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      Data="M 19.3 3.0 C 17.8 2.3 16.2 1.8 14.6 1.5 C 14.4 1.9 14.2 2.3 14.0 2.8 C 12.3 2.5 10.6 2.5 8.9 2.8 C 8.7 2.3 8.5 1.9 8.3 1.5 C 6.7 1.8 5.1 2.3 3.6 3.0 C 0.6 7.5 -0.2 11.9 0.1 16.2 C 2.1 17.7 4.0 18.6 5.9 19.2 C 6.4 18.5 6.8 17.8 7.2 17.0 C 6.5 16.8 5.9 16.4 5.3 16.0 C 5.4 15.9 5.6 15.7 5.7 15.6 C 9.4 17.3 13.5 17.3 17.2 15.6 C 17.3 15.7 17.5 15.9 17.6 16.0 C 17.0 16.4 16.4 16.8 15.7 17.0 C 16.1 17.8 16.5 18.5 17.0 19.2 C 18.9 18.6 20.8 17.7 22.8 16.2 C 23.3 11.2 21.9 6.8 19.3 3.0 Z M 7.7 13.7 C 6.6 13.7 5.7 12.7 5.7 11.4 C 5.7 10.2 6.6 9.2 7.7 9.2 C 8.8 9.2 9.7 10.2 9.7 11.4 C 9.7 12.7 8.8 13.7 7.7 13.7 Z M 15.2 13.7 C 14.1 13.7 13.2 12.7 13.2 11.4 C 13.2 10.2 14.1 9.2 15.2 9.2 C 16.3 9.2 17.2 10.2 17.2 11.4 C 17.2 12.7 16.3 13.7 15.2 13.7 Z"
                                                      Fill="#FFFFFF"
                                                      Opacity="0.95">
                                                    <Path.RenderTransform>
                                                        <ScaleTransform x:Name="LogoEmblemScale" ScaleX="1" ScaleY="1"/>
                                                    </Path.RenderTransform>
                                                    <Path.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                                    </Path.Effect>
                                                </Path>
                                            </Viewbox>

                                            <Canvas HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Width="12" Height="16">
                                                <Ellipse x:Name="KeyholeTop" Width="8" Height="8" Canvas.Left="2" Fill="#232428" Opacity="0.85"/>
                                                <Path x:Name="KeyholeBottom" Data="M 3 5 L 9 5 L 7 14 L 5 14 Z" Fill="#232428" Opacity="0.85"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <TextBlock x:Name="StatusLabel" Text="DISCONNECTED" Foreground="#F2F3F5" FontSize="18.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="StatusSubLabel" Text="Discord traffic is direct" Foreground="#949BA4" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>

                        <ComboBox x:Name="RegionCombo" Style="{StaticResource DiscordComboBoxStyle}"
                                  ItemTemplate="{StaticResource RegionOptionTemplate}"
                                  Width="264" Height="38" Margin="0,10,0,0"
                                  MaxDropDownHeight="240"
                                  SelectionChanged="RegionCombo_SelectionChanged"/>

                        <Border x:Name="SecurityPill" Visibility="Collapsed" Background="#33000000" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="SecurityPillText" Text="Protected Route" Foreground="#E3E5E8" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="ConnectBtn" Style="{StaticResource DiscordPillButtonStyle}" Click="ConnectBtn_Click"
                                Width="236" Height="48" Content="Connect" Background="{StaticResource ButtonIdleGradient}">
                            <Button.Effect>
                                <DropShadowEffect x:Name="BtnShadow" BlurRadius="22" ShadowDepth="4" Opacity="0.45" Color="#5865F2"/>
                            </Button.Effect>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,2">
                        <TextBlock Text="Starting Discord may take a few tries to connect. Closing and reopening Discord may also solve the issue."
                                   Foreground="#8E9297" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" LineHeight="14"/>
                    </Grid>

                    <Grid Grid.Row="4" Margin="24,0,24,14" VerticalAlignment="Center">
                        <Border Background="#18191C" CornerRadius="20" Padding="16,10" BorderBrush="#2B2D31" BorderThickness="1">
                            <Grid>
                                <CheckBox x:Name="MinimizeToTrayCheckBox" Style="{StaticResource DiscordToggleSwitchStyle}" IsChecked="True" VerticalAlignment="Center">
                                    <TextBlock Text="Minimize to system tray" Foreground="#DBDEE1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </CheckBox>
                                <TextBlock Text="v1.0.1" Foreground="#80848E" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="PrivacyOverlay" Visibility="Collapsed" Background="#F2111215">
                    <Grid Margin="26,24,26,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Privacy Policy" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" SnapsToDevicePixels="True" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Discord Shield operates entirely on your local computer."
                                           Foreground="#F2F3F5" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <TextBlock Text="Local Operation" Foreground="#DBDEE1" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="Packet desynchronization occurs directly on your machine. Discord connects directly to Discord servers without passing through external proxy or VPN servers."
                                           Foreground="#949BA4" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,14"/>

                                <TextBlock Text="Zero Data Collection" Foreground="#DBDEE1" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="The application does not collect, log, store, or transmit any user credentials, tokens, messages, voice data, or personal details."
                                           Foreground="#949BA4" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,14"/>

                                <TextBlock Text="No Telemetry or Tracking" Foreground="#DBDEE1" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="There is no analytics tracking, remote reporting, or telemetry integrated into this application."
                                           Foreground="#949BA4" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,14"/>

                                <TextBlock Text="Open Source Verification" Foreground="#DBDEE1" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="All source code is publicly auditable on GitHub at github.com/arshiatxd/discordshield."
                                           Foreground="#949BA4" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" Click="ClosePrivacyPolicy_Click" Style="{StaticResource DiscordPillButtonStyle}"
                                Width="140" Height="36" Content="Close" Background="{StaticResource ButtonIdleGradient}" FontSize="12"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>