<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Product>Discord Shield</Product>
    <Company>Discord Shield Contributors</Company>
    <Authors>Discord Shield Contributors</Authors>
    <Description>Zero-Trust Local DPI Evasion and Encrypted Tunnel for Discord</Description>
    <Copyright>Copyright © 2026 Discord Shield Contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app_logo.png" />
    <Resource Include="app.ico" />
    <Resource Include="flag_ir.png" />
    <None Update="Core\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Uninstall Discord Shield.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
